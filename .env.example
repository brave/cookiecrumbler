SENTRY_DSN=""
SENTRY_ENVIRONMENT=local
WPR_LOG_LEVEL=warn

# Ministack (local AWS emulator, `docker compose --profile s3 up ministack`):
# dev S3 endpoint for WPR archives. Compose-network address (the app resolves
# the service name via Docker DNS; all AWS services share port 4566). Default
# ministack credentials; AWS_* names are avoided here so they don't leak into
# litellm's Bedrock creds.
MINISTACK_REGION=us-east-1
S3_ENDPOINT_URL=http://ministack:4566
S3_ACCESS_KEY_ID=test
S3_SECRET_ACCESS_KEY=test
