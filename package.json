{
  "name": "cookiecrumbler",
  "description": "Automatically gobble up cookie consent notices",
  "license": "MPL-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/brave/cookiecrumbler"
  },
  "scripts": {
    "setup": "node src/setup.mjs",
    "serve": "node --import ./src/instrument.mjs src/api.mjs",
    "rebrowser-patches": "rebrowser-patches patch --packageName puppeteer-core",
    "test": "node --test test/test.mjs",
    "test:wpr": "node --test --test-name-pattern \"WPR replay\" test/test.mjs",
    "test:ci": "node --test --test-reporter=spec --test-reporter-destination=stdout --test-reporter=@reporters/github --test-reporter-destination=stdout test/test.mjs",
    "lint": "eslint",
    "lint-fix": "eslint --fix",
    "build": "esbuild --bundle --format=cjs --sourcemap --outdir=bundles src/inpage/index.mjs",
    "watch": "pnpm run build --watch",
    "typecheck": "tsc -p tsconfig.json"
  },
  "main": "src/lib.mjs",
  "packageManager": "pnpm@12.14.0+sha512.c18ba6d87993d3d164cb5e8948f32b2c06ee854487e06cd8d86781342fb3e5bb4634367034711e86802baa9c37bea906ce1929ad08d70884c97d801df13389a6",
  "dependencies": {
    "@gorhill/publicsuffixlist": "^3.0.1",
    "@koa/bodyparser": "^6.0.0",
    "@koa/router": "^15.0.0",
    "@sentry/node": "^11.0.0",
    "async-mutex": "^0.5.0",
    "error-stack-parser": "^2.1.4",
    "koa": "^3.0.1",
    "koa-compress": "^5.1.1",
    "openai": "^6.0.0",
    "proxy-chain": "^3.0.0",
    "puppeteer-core": "~25.14.0",
    "puppeteer-extra": "^3.3.6",
    "puppeteer-extra-plugin": "^3.2.3",
    "puppeteer-extra-plugin-stealth": "^2.11.2",
    "rebrowser-patches": "^1.1.1",
    "rehype-format": "^5.0.0",
    "rehype-parse": "^9.0.0",
    "rehype-stringify": "^10.0.0",
    "source-map": "^0.8.0",
    "unified": "^11.0.4"
  },
  "devDependencies": {
    "@reporters/github": "2.1.4",
    "@types/node": "26.5.0",
    "esbuild": "0.28.2",
    "eslint": "10.13.0",
    "neostandard": "0.14.1",
    "tree-walker-shadow-dom": "1.0.0",
    "typescript": "6.0.3"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "24.22.1",
      "onFail": "download"
    }
  }
}
